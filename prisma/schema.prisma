generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(cuid())
  username      String         @unique
  email         String         @unique
  passwordHash  String
  role          Role           @default(USER)
  emailVerified DateTime?
  banned        Boolean        @default(false)
  bannedReason  String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  adminLogs     AdminLog[]     @relation("AdminActor")
  auditLogs     AuditLog[]     @relation("AuditActor")
  cart          Cart?
  couponUsages  CouponUsage[]
  downloads     Download[]
  emailTokens   EmailToken[]
  licenses      License[]
  notifications Notification[]
  orders        Order[]
  profile       Profile?
  refunds       Refund[]
  reviews       Review[]
  seller        Seller?
  sessions      Session[]
  wishlist      Wishlist[]

  @@index([role])
}

model Profile {
  id              String   @id @default(cuid())
  userId          String   @unique
  avatarUrl       String?
  robloxUserId    String?
  discordUsername String?
  bio             String?
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([robloxUserId])
}

model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  ip         String?
  userAgent  String?
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model EmailToken {
  id        String         @id @default(cuid())
  tokenHash String         @unique
  type      EmailTokenType
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime       @default(now())
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

model Category {
  id        String            @id @default(cuid())
  name      String            @unique
  slug      String            @unique
  sortOrder Int               @default(0)
  products  ProductCategory[]
}

model Product {
  id                  String            @id @default(cuid())
  slug                String            @unique
  name                String
  description         String
  features            String[]
  requirements        String?
  price               Int
  discountPercent     Int               @default(0)
  currency            String            @default("IDR")
  status              ProductStatus     @default(DRAFT)
  featured            Boolean           @default(false)
  licenseType         LicenseType       @default(PERSONAL)
  licenseMode         LicenseMode       @default(NONE)
  sourceMode          SourceMode        @default(CLOSED_SOURCE)
  freeDownloadUrl     String?
  externalDownloadUrl String?
  allowRepurchase     Boolean           @default(false)
  robloxCompat        String?
  thumbnailUrl        String?
  salesCount          Int               @default(0)
  ratingAvg           Float             @default(0)
  ratingCount         Int               @default(0)
  sellerId            String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  cartItems           CartItem[]
  licenses            License[]
  orderItems          OrderItem[]
  seller              Seller?           @relation(fields: [sellerId], references: [id])
  categories          ProductCategory[]
  files               ProductFile[]
  images              ProductImage[]
  versions            ProductVersion[]
  reviews             Review[]
  sellerLinks         SellerProduct[]
  wishlist            Wishlist[]

  @@index([status, createdAt])
  @@index([status, salesCount])
  @@index([sellerId])
}

model ProductCategory {
  productId  String
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  sortOrder Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductVersion {
  id         String        @id @default(cuid())
  productId  String
  version    String
  changelog  String?
  isLatest   Boolean       @default(false)
  createdAt  DateTime      @default(now())
  files      ProductFile[]
  product    Product       @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, version])
}

model ProductFile {
  id         String          @id @default(cuid())
  productId  String
  versionId  String?
  storageKey String
  fileName   String
  mimeType   String
  sizeBytes  BigInt
  sha256     String?
  createdAt  DateTime        @default(now())
  downloads  Download[]
  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  version    ProductVersion? @relation(fields: [versionId], references: [id])

  @@index([productId])
}

model Cart {
  id         String     @id @default(cuid())
  userId     String     @unique
  couponCode String?
  updatedAt  DateTime   @updatedAt
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items      CartItem[]
}

model CartItem {
  id        String  @id @default(cuid())
  cartId    String
  productId String
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model Order {
  id             String        @id @default(cuid())
  orderNumber    String        @unique
  userId         String
  status         OrderStatus   @default(PENDING)
  subtotal       Int
  discountTotal  Int           @default(0)
  total          Int
  currency       String        @default("IDR")
  couponId       String?
  idempotencyKey String?       @unique
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  couponUsages   CouponUsage[]
  licenses       License[]
  coupon         Coupon?       @relation(fields: [couponId], references: [id])
  user           User          @relation(fields: [userId], references: [id])
  items          OrderItem[]
  payments       Payment[]
  refunds        Refund[]

  @@index([userId, createdAt])
  @@index([status])
}

model OrderItem {
  id         String  @id @default(cuid())
  orderId    String
  productId  String
  sellerId   String?
  name       String
  unitPrice  Int
  discount   Int     @default(0)
  total      Int
  commission Int     @default(0)
  order      Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product    Product @relation(fields: [productId], references: [id])
  
  @@index([orderId])
  @@index([productId])
  @@index([sellerId])
}

model Payment {
  id           String        @id @default(cuid())
  orderId      String
  provider     String
  method       String?
  providerRef  String?
  amount       Int
  currency     String        @default("IDR")
  status       PaymentStatus @default(PENDING)
  paymentUrl   String?
  rawPayload   Json?
  paidAt       DateTime?
  expiresAt    DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  order        Order         @relation(fields: [orderId], references: [id])
  transactions Transaction[]

  @@unique([provider, providerRef])
  @@index([orderId])
  @@index([status])
}

model WebhookEvent {
  id          String    @id @default(cuid())
  provider    String
  eventId     String
  payload     Json
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([provider, eventId])
}

model Transaction {
  id        String          @id @default(cuid())
  type      TransactionType
  paymentId String?
  sellerId  String?
  amount    Int
  currency  String          @default("IDR")
  note      String?
  createdAt DateTime        @default(now())
  payment   Payment?        @relation(fields: [paymentId], references: [id])

  @@index([type, createdAt])
}

model Refund {
  id        String       @id @default(cuid())
  orderId   String
  userId    String
  reason    String
  status    RefundStatus @default(REQUESTED)
  amount    Int
  adminNote String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  order     Order        @relation(fields: [orderId], references: [id])
  user      User         @relation(fields: [userId], references: [id])

  @@index([status])
}

model License {
  id             String              @id @default(cuid())
  key            String              @unique
  productId      String
  userId         String
  orderId        String?
  robloxUserId   String?
  status         LicenseStatus       @default(ACTIVE)
  expiresAt      DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  downloads      Download[]
  downloadTokens DownloadToken[]
  order          Order?              @relation(fields: [orderId], references: [id])
  product        Product             @relation(fields: [productId], references: [id])
  user           User                @relation(fields: [userId], references: [id])
  activations    LicenseActivation[]

  @@index([userId])
  @@index([productId])
}

model LicenseActivation {
  id           String   @id @default(cuid())
  licenseId    String
  placeId      String?
  robloxUserId String?
  createdAt    DateTime @default(now())
  active       Boolean  @default(true)
  license      License  @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@index([licenseId])
}

model DownloadToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  licenseId String?
  userId    String
  fileId    String
  expiresAt DateTime
  usedCount Int       @default(0)
  maxUses   Int       @default(3)
  createdAt DateTime  @default(now())
  license   License?  @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@index([licenseId])
}

model Download {
  id        String      @id @default(cuid())
  userId    String
  fileId    String
  licenseId String
  orderId   String?
  ip        String?
  userAgent String?
  createdAt DateTime    @default(now())
  file      ProductFile @relation(fields: [fileId], references: [id])
  license   License     @relation(fields: [licenseId], references: [id])
  user      User        @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([licenseId])
}

model Review {
  id        String       @id @default(cuid())
  userId    String
  productId String
  rating    Int
  comment   String
  status    ReviewStatus @default(APPROVED)
  createdAt DateTime     @default(now())
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id])

  @@unique([userId, productId])
  @@index([productId, status])
}

model Coupon {
  id           String        @id @default(cuid())
  code         String        @unique
  type         DiscountType
  value        Int
  minPurchase  Int           @default(0)
  maxUses      Int?
  perUserLimit Int           @default(1)
  expiresAt    DateTime?
  productIds   String[]
  categoryIds  String[]
  active       Boolean       @default(true)
  usedCount    Int           @default(0)
  createdAt    DateTime      @default(now())
  usages       CouponUsage[]
  orders       Order[]
}

model CouponUsage {
  id        String   @id @default(cuid())
  couponId  String
  userId    String
  orderId   String
  createdAt DateTime @default(now())
  coupon    Coupon   @relation(fields: [couponId], references: [id])
  order     Order   @relation(fields: [orderId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@index([couponId, userId])
}

model Seller {
  id                String          @id @default(cuid())
  userId            String          @unique
  storeName         String
  status            SellerStatus    @default(PENDING)
  commissionPercent Int?
  createdAt         DateTime        @default(now())
  payouts           Payout[]
  products          Product[]
  user              User            @relation(fields: [userId], references: [id])
  links             SellerProduct[]
}

model SellerProduct {
  sellerId  String
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  seller    Seller  @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@id([sellerId, productId])
}

model Payout {
  id        String       @id @default(cuid())
  sellerId  String
  amount    Int
  status    PayoutStatus @default(PENDING)
  note      String?
  createdAt DateTime     @default(now())
  paidAt    DateTime?
  seller    Seller       @relation(fields: [sellerId], references: [id])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

model Announcement {
  id        String    @id @default(cuid())
  title     String
  body      String
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
}

model AdminLog {
  id        String   @id @default(cuid())
  adminId   String
  action    String
  target    String?
  meta      Json?
  createdAt DateTime @default(now())
  admin     User     @relation("AdminActor", fields: [adminId], references: [id])

  @@index([createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String?
  entityId  String?
  ip        String?
  userAgent String?
  meta      Json?
  createdAt DateTime @default(now())
  actor     User?    @relation("AuditActor", fields: [actorId], references: [id])

  @@index([action, createdAt])
  @@index([actorId])
}

model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model ApiKey {
  id        String   @id @default(cuid())
  name      String
  keyHash   String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

enum Role {
  USER
  SELLER
  ADMIN
  OWNER
}

enum ProductStatus {
  DRAFT
  PENDING
  PUBLISHED
  ARCHIVED
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  CANCELLED
  REFUNDED
}

enum LicenseStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum LicenseType {
  PERSONAL
  COMMERCIAL
  UNLIMITED
}

enum LicenseMode {
  NONE
  REQUIRED
  OPTIONAL
}

enum SourceMode {
  CLOSED_SOURCE
  OPEN_SOURCE
}

enum ReviewStatus {
  PENDING
  APPROVED
  HIDDEN
}

enum RefundStatus {
  REQUESTED
  APPROVED
  REJECTED
  COMPLETED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum EmailTokenType {
  VERIFY_EMAIL
  RESET_PASSWORD
}

enum SellerStatus {
  PENDING
  APPROVED
  SUSPENDED
}

enum PayoutStatus {
  PENDING
  PAID
  FAILED
}

enum TransactionType {
  PAYMENT
  REFUND
  PAYOUT
  COMMISSION
}